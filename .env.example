# farmline — environment template. Copy to .env and fill in.
# This repo reads env via src/config.js (no dotenv dependency), checking
# process.env first, then this file.

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4600
BASE_PATH=/farmline
NODE_ENV=development

# ── AUTH ──────────────────────────────────────────────────────────────────────
# The write gate. While this is UNSET the gate fails OPEN and says so once, so a
# keyless local dev still works. Set it before the droplet goes public.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin gate for /api/farmline/admin/*. Unset = the door is sealed (403).
FARMLINE_ADMIN_KEY=

# ── DATABASE ──────────────────────────────────────────────────────────────────
# farmline owns its OWN database. It must never write to `zyppar` or `rolodex`.
# Local dev (the mongod already running on this machine):
FARMLINE_USE_LOCAL_MONGO=true
MONGO_LOCAL_URI=mongodb://localhost:27017/farmline
# Explicit override (takes precedence over everything above):
# MONGO_DB_URI_FARMLINE=

# Droplet: derive `farmline` from the shared paid cluster instead of the local mongod.
# FARMLINE_USE_LOCAL_MONGO=false
# MONGO_DB_URI_PAID=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true

# ── MONEY — ZU ONLY (rewritten 2026-10-11; the doctrine is the authority) ─────
# Farmline sells ONE thing — ZU — and ZU unlocks the paid rungs. Money moves ONE
# WAY: the farmer pays US, claims it, and the operator confirms. Farmline is never
# between a farmer and a buyer, so there is no money mode, no rail, no FX peg and
# no outbound payment credentials to hold. See D:\TODOs\farmline-zu-doctrine-20261011.md.
#
# REMOVED, and DO NOT SET THEM AGAIN (they are dead; preflight will tell you):
#   MONEY_MODE, ZU_PER_KES, MPESA_CONSUMER_KEY, MPESA_CONSUMER_SECRET,
#   MPESA_SHORTCODE, MPESA_PASSKEY, MPESA_ENV, MPESA_CALLBACK_SECRET
#
# THE ZU DOOR: the collection details WE publish, in your own words — the bank
# account, the till/paybill, whatever a farmer should pay into. This is plain text
# that the app shows to farmers; nothing parses it and no provider is involved.
# Multi-line is fine. WHILE THIS IS EMPTY THE DOOR IS HONESTLY CLOSED: the free
# rungs still work, and no farmer can buy a paid one yet.
FARMLINE_ZU_COLLECTION=

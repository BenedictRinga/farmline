# farmline — environment template. Copy to .env and fill in.
# This repo reads env via src/config.js (no dotenv dependency), checking
# process.env first, then this file.

# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=4600
BASE_PATH=/farmline
NODE_ENV=development

# ── AUTH ──────────────────────────────────────────────────────────────────────
# The write gate. While this is UNSET the gate fails OPEN and says so once, so a
# keyless local dev still works. Set it before the droplet goes public.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Admin gate for /api/farmline/admin/*. Unset = the door is sealed (403).
FARMLINE_ADMIN_KEY=

# ── DATABASE ──────────────────────────────────────────────────────────────────
# farmline owns its OWN database. It must never write to `zyppar` or `rolodex`.
# Local dev (the mongod already running on this machine):
FARMLINE_USE_LOCAL_MONGO=true
MONGO_LOCAL_URI=mongodb://localhost:27017/farmline
# Explicit override (takes precedence over everything above):
# MONGO_DB_URI_FARMLINE=

# Droplet: derive `farmline` from the shared paid cluster instead of the local mongod.
# FARMLINE_USE_LOCAL_MONGO=false
# MONGO_DB_URI_PAID=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true

# ── MONEY (AGENTS.md rule 2) ──────────────────────────────────────────────────
# virtual = ZU (Zyppar Units, 1 ZU ≈ $0.01)   |   mpesa = real money
# This is only the DEFAULT; each farm carries its own switch and may flip it.
MONEY_MODE=virtual

# How many ZU one KES buys. 1 USD ≈ 130 KES and 1 ZU ≈ $0.01 ⇒ ~0.13.
ZU_PER_KES=0.13

# M-Pesa (Daraja). While these are blank the rail honestly reports itself as
# unarmed and the farm's mode cannot be switched to mpesa — no fake successes.
# In mpesa mode money goes to the FARM's own paybill/till, never to farmline.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENV=sandbox
